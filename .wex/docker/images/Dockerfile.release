# wex/release: wex on its base image (Dockerfile.release.base), which holds
# everything but wex. Only the wex package and its wexample packages are
# installed here, so the arm64 half, emulated, takes minutes, not half an hour.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}

ARG WEX_VERSION

RUN apt-get update -qq \
    && apt-get install -y wex \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# apt serves whatever is current, so an image tagged 6.0.129 could hold anything
# the mirror happened to have. Fail the build rather than ship a lying tag.
RUN test -z "${WEX_VERSION}" || test "$(wex version)" = "${WEX_VERSION}"
