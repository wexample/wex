# The GitLab runner that publishes our package suites: the official runner
# image, plus wex and the docker client. Jobs run in it through the shell
# executor, so what a publication needs on the developer's machine has to be
# here — wex to drive it, docker to run the test containers and the Roave
# image on the host's daemon, git and ssh to push.
#
# Built by wex's own pipeline, like wex/release: it must carry the wex just
# released, and nothing else decides its version.
FROM gitlab/gitlab-runner:v19.0.1

ARG WEX_VERSION
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update -qq \
    && apt-get install -y --no-install-recommends ca-certificates curl git gnupg2 openssh-client sudo wget \
    && install -m 0755 -d /etc/apt/keyrings \
    # Docker's own repository: the client and the buildx and compose plugins,
    # no daemon — the jobs talk to the host's through its socket.
    && curl -fsSL https://download.docker.com/linux/ubuntu/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg \
    && chmod a+r /etc/apt/keyrings/docker.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/ubuntu $(. /etc/os-release && echo $VERSION_CODENAME) stable" > /etc/apt/sources.list.d/docker.list \
    && wget -O - https://apt.wexample.com/gpg | gpg --dearmor -o /etc/apt/trusted.gpg.d/wexample.gpg \
    && echo "deb http://apt.wexample.com/ stable main" > /etc/apt/sources.list.d/wexample.list \
    && apt-get update -qq \
    && apt-get install -y --no-install-recommends docker-ce-cli docker-buildx-plugin docker-compose-plugin wex \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# apt serves whatever is current: fail the build rather than tag it with a
# version it does not hold.
RUN test -z "${WEX_VERSION}" || test "$(wex version)" = "${WEX_VERSION}"
