# The GitLab runner that publishes our package suites: wex on its base image
# (Dockerfile.runner.base), which holds the official runner image and what a
# suite publication runs. Jobs run in it through the shell executor, so what a
# publication needs on the developer's machine has to be there.
#
# Built by wex's own pipeline, like wex/release: it must carry the wex just
# released, and nothing else decides its version.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}

ARG WEX_VERSION

RUN apt-get update -qq \
    && apt-get install -y --no-install-recommends wex \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# apt serves whatever is current: fail the build rather than tag it with a
# version it does not hold.
RUN test -z "${WEX_VERSION}" || test "$(wex version)" = "${WEX_VERSION}"
